# Образец настроек для server/orders.py. Скопируйте в /etc/pilotarbuza/orders.env и заполните.
# Настоящий файл с хешем и токеном в репозиторий не кладите.

# Строка из команды: python3 server/orders.py hash
ADMIN_PASSWORD_HASH=

# База заказов — вне папки сайта
ORDERS_DB=/var/lib/pilotarbuza/orders.db

ORDERS_HOST=127.0.0.1
ORDERS_PORT=8787

# Необязательно: уведомления о новых предзаказах в Telegram
TG_BOT_TOKEN=
TG_CHAT_ID=
